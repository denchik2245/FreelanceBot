# Сообщения отправляет сообщество VK. Пользователь должен сначала написать ему.
VK_GROUP_TOKEN=
VK_USER_ID=
VK_API_VERSION=5.199

# Учетная запись Kwork нужна для доступа к бирже проектов.
KWORK_LOGIN=
KWORK_PASSWORD=

# Учетная запись специалиста Profi.ru. Выдача использует услуги, сохранённые в аккаунте.
PROFI_LOGIN=
PROFI_PASSWORD=

# AI-фильтр и готовые отклики через GigaChat API.
AI_ENABLED=true
AI_FAIL_OPEN=false
AI_MIN_SCORE=70
AI_PROFILE_PATH=config/freelancer_profile.txt
AI_FILTER_PROMPT_PATH=config/prompts/project_filter.txt
AI_RESPONSE_PROMPT_PATH=config/prompts/response_writer.txt
GIGACHAT_CREDENTIALS=
GIGACHAT_SCOPE=GIGACHAT_API_PERS
GIGACHAT_BASE_URL=https://api.giga.chat/v1
GIGACHAT_CA_BUNDLE_FILE=certs/russian_trusted_root_ca_pem.crt
GIGACHAT_FILTER_MODEL=GigaChat-2-Pro
GIGACHAT_RESPONSE_MODEL=GigaChat-2-Pro

POLL_INTERVAL_SECONDS=180
DATABASE_PATH=data/bot.sqlite3
SEND_EXISTING_ON_FIRST_RUN=false
LOG_LEVEL=INFO
